# Orbit agent (Ground Control in iMessage). Copy to .env — it's gitignored.

# Photon dashboard (app.photon.codes) → your project → Settings
SPECTRUM_PROJECT_ID=
SPECTRUM_PROJECT_SECRET=

# Auto-registers crew numbers on Photon's Pro allowlist (no manual "Users" step).
# Log in once with `npx @photon-ai/cli login` (or paste a token in PHOTON_TOKEN).
# Photon needs an email per user: each number gets you+orbit<digits>@yourdomain.
PHOTON_USER_EMAIL=
PHOTON_TOKEN=

# Supabase Dashboard → Project Settings → API.
# The SERVICE ROLE key bypasses row-level security — it must only ever live
# here on the server, never in the iOS app.
SUPABASE_URL=https://qfwjjveaigvppstrjwhw.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# Optional: lets Ground Control write a context-aware landing line.
# Without it, a friendly fixed line is used.
GEMINI_API_KEY=
