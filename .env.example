# Orbit — environment template. Copy to .env (gitignored) for server-side tools.
# The iOS app reads its values from OrbitApp/Shared/Services/Secrets.swift
# (copy Secrets.swift.example); this file is for the Supabase CLI / Edge Function.

# Supabase Dashboard → Project Settings → API
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Google AI Studio → https://aistudio.google.com/apikey
# Set on the server with: supabase secrets set GEMINI_API_KEY=...
GEMINI_API_KEY=

# Photon (hackathon partner) — fill in once the organizer docs arrive.
PHOTON_API_KEY=
