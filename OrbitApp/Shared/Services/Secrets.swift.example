import Foundation

// Copy this file to Secrets.swift (same folder) and fill in your values.
// Secrets.swift is gitignored — never commit real keys.
enum Secrets {
    /// Supabase Dashboard → Project Settings → API → Project URL
    static let supabaseURL = "https://YOUR-PROJECT.supabase.co"
    /// Supabase Dashboard → Project Settings → API → publishable (anon) key
    static let supabaseAnonKey = "YOUR-ANON-KEY"
    /// Only needed if useGroundControlFunction is false. Get one free at
    /// https://aistudio.google.com/apikey
    static let geminiAPIKey = ""
    /// true after `supabase functions deploy ground-control` (docs/SERVER_SETUP.md):
    /// the app then calls the Edge Function and the Gemini key stays server-side.
    static let useGroundControlFunction = false
}
